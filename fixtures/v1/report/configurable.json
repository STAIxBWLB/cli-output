{
  "id": "configurable-layout",
  "input": {
    "columns": 80,
    "ascii": false,
    "operations": [
      {
        "op": "table",
        "head": [
          "state",
          "empty",
          "detail"
        ],
        "rows": [
          [
            {
              "text": "ok",
              "role": "success"
            },
            "",
            "ready"
          ],
          [
            {
              "text": "fail",
              "role": "error"
            },
            "",
            "broken"
          ]
        ],
        "flexible": 2,
